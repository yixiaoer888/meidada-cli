{
  "name": "@meidada-cn/cli",
  "version": "0.3.7-pre.1",
  "description": "媒大大官方内容投放 CLI",
  "type": "module",
  "bin": {
    "mdd": "./bin/mdd.js"
  },
  "files": [
    "bin",
    "references",
    "schemas",
    "skills",
    "checksums.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yixiaoer888/meidada-cli.git"
  },
  "bugs": {
    "url": "https://github.com/yixiaoer888/meidada-cli/issues"
  },
  "homepage": "https://github.com/yixiaoer888/meidada-cli#readme",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --target=node --outfile=bin/mdd-core.js",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "schemas": "bun scripts/generate-json-schemas.ts",
    "check:package-docs": "bun scripts/check-package-docs.ts",
    "checksums": "bun scripts/write-package-checksums.ts",
    "release": "bun scripts/build-release.ts",
    "prepack": "bun run build && bun run schemas && bun run check:package-docs && bun run checksums"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.13",
    "commander": "^14.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2",
    "typescript": "^7.0.2"
  }
}
