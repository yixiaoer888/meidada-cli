{
  "name": "@meidada-cn/cli",
  "version": "0.3.4",
  "description": "媒大大官方内容投放 CLI",
  "type": "module",
  "bin": {
    "mdd": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuxin123456122-commits/meidada-cli.git"
  },
  "bugs": {
    "url": "https://github.com/liuxin123456122-commits/meidada-cli/issues"
