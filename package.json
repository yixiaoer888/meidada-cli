  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "release": "bun scripts/build-release.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
