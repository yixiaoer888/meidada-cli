{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "NEWS",
        "WE_MEDIA",
        "OVERSEAS"
      ],
      "description": "渠道:NEWS 新闻 / WE_MEDIA 自媒体 / OVERSEAS 海外"
    },
    "mediaIds": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      },
      "description": "目标媒体 ID 列表(1~50 家,同一篇稿件批量投放)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "稿件标题"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "稿件正文(富文本 HTML)"
    },
    "keyword": {
      "description": "话题关键词(当前 CLI 投放渠道忽略)",
      "$ref": "#/$defs/__schema1"
    },
    "remark": {
      "description": "发稿要求/备注(选填)",
      "$ref": "#/$defs/__schema2"
    },
    "customerName": {
      "description": "所属客户名称(选填)",
      "$ref": "#/$defs/__schema3"
    },
    "accountRule": {
      "description": "账号规则:1/2/3(具体含义见上游平台说明,默认 1)",
      "$ref": "#/$defs/__schema4"
    },
    "articleType": {
      "description": "文章类型:1/2/3(具体含义见上游平台说明,默认 1)",
      "$ref": "#/$defs/__schema5"
    },
    "allowVideo": {
      "description": "视频:0 不含视频 / 1 允许视频 / 3 仅视频(默认 0)",
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "channel",
    "mediaIds",
    "title",
    "content"
  ],
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "type": "string",
      "maxLength": 200
    },
    "__schema4": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "__schema5": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "__schema6": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    }
  },
  "$id": "https://npmjs.com/package/@meidada-cn/cli/schemas/publish.schema.json",
  "title": "BatchOrderBody"
}
