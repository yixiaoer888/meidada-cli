{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draftIds": {
      "$ref": "#/$defs/__schema0"
    },
    "channel": {
      "$ref": "#/$defs/__schema2"
    },
    "mediaIds": {
      "$ref": "#/$defs/__schema3"
    },
    "customerId": {
      "$ref": "#/$defs/__schema5"
    },
    "remark": {
      "$ref": "#/$defs/__schema6"
    },
    "repeat": {
      "$ref": "#/$defs/__schema7"
    },
    "startAt": {
      "$ref": "#/$defs/__schema8"
    },
    "timezone": {
      "$ref": "#/$defs/__schema9"
    },
    "runAt": {
      "$ref": "#/$defs/__schema10"
    },
    "budgetPerRun": {
      "$ref": "#/$defs/__schema11"
    },
    "budgetTotal": {
      "$ref": "#/$defs/__schema12"
    },
    "keepDraft": {
      "$ref": "#/$defs/__schema13"
    }
  },
  "required": [
    "draftIds",
    "channel",
    "mediaIds",
    "repeat",
    "startAt",
    "timezone",
    "runAt",
    "budgetPerRun"
  ],
  "$defs": {
    "__schema0": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "NEWS",
        "WE_MEDIA",
        "OVERSEAS"
      ]
    },
    "__schema3": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "type": "string",
      "minLength": 1
    },
    "__schema6": {
      "type": "string",
      "maxLength": 500
    },
    "__schema7": {
      "type": "string",
      "enum": [
        "ONCE",
        "DAILY"
      ]
    },
    "__schema8": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "__schema10": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "__schema11": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema12": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema13": {
      "default": false,
      "type": "boolean"
    }
  },
  "$id": "https://npmjs.com/package/@meidada-cn/cli/schemas/schedule.schema.json",
  "title": "PublishSchedulePayload"
}
